# AGEP environment configuration.
# Copy to .env and adjust as needed.

# Which LLM backend to use. Default: claude-code (no API key needed — uses
# your local Claude Code authentication via claude-agent-sdk).
AGEP_LLM=claude-code
# AGEP_LLM=anthropic
# AGEP_LLM=gemini

# Optional model override. If unset, each backend uses a sensible Sonnet-tier default.
# claude-code defaults: "sonnet"
# anthropic   defaults: "anthropic/claude-sonnet-4-5"
# gemini      defaults: "gemini-2.5-flash"
# AGEP_MODEL=sonnet
# AGEP_MODEL=opus
# AGEP_MODEL=claude-sonnet-4-5-20250929
# AGEP_MODEL=gemini-2.5-pro

# Only needed if you pick a keyed backend above.
# GOOGLE_API_KEY=...
# ANTHROPIC_API_KEY=...

# ---------------------------------------------------------------------------
# v3 — optional integrations
# ---------------------------------------------------------------------------

# Live grocery pricing via Spoonacular. Default is "simulated" (zero config).
# Free tier: 150 requests/day at https://spoonacular.com/food-api/console
# AGEP_GROCERY=simulated
# AGEP_GROCERY=spoonacular
# SPOONACULAR_API_KEY=...

# Dish image generation. Requires GOOGLE_API_KEY (set above) and `google-genai`.
# Override the default Gemini image model:
# AGEP_IMAGE_MODEL=gemini-2.5-flash-image-preview

# Stream Claude Code subprocess stderr to the terminal (debug only).
# AGEP_DEBUG=1
